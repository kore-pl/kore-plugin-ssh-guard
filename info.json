{
  "id": "ssh-guard",
  "name": "SSH 加固插件",
  "description": "SSH 登录防护：审计 sshd 配置、封禁可疑 IP、生成加固建议（建议态，不自动下发）",
  "version": "0.3.0",
  "protocol": "kore.plugin.v1",
  "lifecycle": "lazy",
  "depth_level": "production",
  "entry": "bin/ssh-guard",
  "capabilities": [
    "system:admin"
  ],
  "method_capabilities": {
    "ssh-guard.status": "system:read",
    "ssh-guard.attempts": "system:read",
    "ssh-guard.bans": "system:read",
    "ssh-guard.suggest": "system:read",
    "ssh-guard.ban.list": "system:read",
    "ssh-guard.ban.add": "system:admin",
    "ssh-guard.ban.remove": "system:admin",
    "ssh-guard.config.get": "system:read",
    "ssh-guard.config.set": "system:admin"
  },
  "triggers": [],
  "requires_kore": ">=0.1.0 <0.2.0",
  "resources": {
    "memory_mb": 6,
    "cpu_quota": "10%",
    "pids_max": 16
  },
  "depends_on": [],
  "conflicts": [],
  "scenario_tags": [
    "sec"
  ],
  "size_bytes": 2840609,
  "requires_root": true,
  "root_actions": [
    {
      "id": "fail2ban-status",
      "argv": [
        "/usr/bin/fail2ban-client",
        "status",
        "sshd"
      ],
      "timeout_s": 10,
      "description": "经内核提权通道读取 fail2ban sshd jail 的封禁状态（只读；插件进程不再直呼 fail2ban-client）。0.2.2 起兼作封禁执行后的回读校验"
    },
    {
      "id": "fail2ban-banip",
      "argv": [
        "/usr/bin/fail2ban-client",
        "set",
        "sshd",
        "banip"
      ],
      "timeout_s": 10,
      "description": "封禁 IP：追加参数为单个合法 IP（如 203.0.113.7）。0.2.2 起由 ssh-guard.ban.add 经本通道真实执行（插件非 root，绝不进程内提权）。不可逆动作，执行前需一次性 confirm 令牌；可能影响合法访问者",
      "irreversible": true
    },
    {
      "id": "fail2ban-unbanip",
      "argv": [
        "/usr/bin/fail2ban-client",
        "set",
        "sshd",
        "unbanip"
      ],
      "timeout_s": 10,
      "description": "解封 IP：追加参数为单个合法 IP（如 203.0.113.7）。0.2.2 起由 ssh-guard.ban.remove 经本通道真实执行。恢复性动作（可再次封禁回滚），无需一次性 confirm 令牌"
    }
  ]
}
